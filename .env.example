DATABASE_URL=postgresql://user:password@host:port/dbname
TELEGRAM_BOT_TOKEN=your_telegram_token_here
NOTION_API_KEY=your_notion_key_here
# 2026-08-02 起改用 OAuth 2.0（真人帳號身分上傳），取代原本的 Service Account 金鑰檔
# （見 docs/specs/submodules-core/SPEC.md ADR-10）：Service Account 沒有 Drive 儲存額度，
# 上傳一律會撞到 storageQuotaExceeded。GDRIVE_OAUTH_REFRESH_TOKEN 由
# submodules/gdrive/get_refresh_token.py 一次性互動授權取得，詳見該腳本開頭說明。
GDRIVE_OAUTH_CLIENT_ID=your_oauth_client_id
GDRIVE_OAUTH_CLIENT_SECRET=your_oauth_client_secret
GDRIVE_OAUTH_REFRESH_TOKEN=your_refresh_token
GDRIVE_FOLDER_ID=XXXXXXXXXXXXX
GMAIL_USER=XXXXXXX@gmail.com
GMAIL_PASSWORD=XXXXXXXXXXXXXXXX
ROBIN_TELEGRAM_TOKEN=XXXXXXXX
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=your-github-username/life-assistant-bot
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
VOICE_API_KEY=your_groq_key
GEMINI_API_BOT_KEY=your_gemini_key
GEMINI_API_IMAGE_KEY1=your_gemini_key
GEMINI_API_IMAGE_KEY2=your_gemini_key
GEMINI_API_TEXT_KEY=your_gemini_key
GEMINI_API_PRIVACY_KEY=your_gemini_key