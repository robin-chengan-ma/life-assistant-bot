# OAuth 2.0（真人帳號身分，Robin 本人授權）：GOOGLE_CALENDAR_OAUTH_REFRESH_TOKEN 由
# get_refresh_token.py 一次性互動授權取得。這組憑證跟 submodules/gdrive 的憑證各自獨立，
# 不共用（見 docs/specs/submodules-core/SPEC.md ADR-12 最小權限設計）。
GOOGLE_CALENDAR_OAUTH_CLIENT_ID=your_oauth_client_id
GOOGLE_CALENDAR_OAUTH_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_CALENDAR_OAUTH_REFRESH_TOKEN=your_refresh_token
GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
